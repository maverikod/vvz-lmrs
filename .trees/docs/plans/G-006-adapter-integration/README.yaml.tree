        {
          "stable_id": "0db2f440-1c3a-43c9-aa21-323d59ed8fff",
          "type": "string",
          "key": "name",
          "value": "Adapter Command Surface and Configuration Integration"
        },
        {
          "stable_id": "3cc7b23c-bd50-4a88-b7c7-6c5e91f7d459",
          "type": "string",
          "key": "description",
          "value": "Define how LMRS exposes its domain commands through the adapter pattern: command registration, thin command wrappers, schemas, metadata, configuration generation, configuration validation, runtime hook entrypoint, and adapter documentation baseline. The step keeps business decisions in LMRS domain concepts while adapter objects expose the public MCP surface."
        },
