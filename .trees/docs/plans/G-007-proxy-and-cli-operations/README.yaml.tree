        {
          "stable_id": "71508a32-a428-4555-ae48-37ad0d943ebc",
          "type": "string",
          "key": "name",
          "value": "Proxy Registration and CLI Operations"
        },
        {
          "stable_id": "3d8ec82c-a4a8-43ce-ada3-13797fa3d412",
          "type": "string",
          "key": "description",
          "value": "Define the operational surfaces around the adapter runtime: local listen endpoint, advertised URL, proxy registration endpoint and protocol resolution, registration lifecycle and payload, CLI command wrappers, metadata-driven CLI help, server manager, and service health verification based on active probes rather than PID-only checks."
        },
