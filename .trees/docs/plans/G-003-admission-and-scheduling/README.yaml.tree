        {
          "stable_id": "ca10271a-8a3c-4073-baaf-6739132db295",
          "type": "string",
          "key": "name",
          "value": "Token Accounting, Admission, Queue, and Scheduling"
        },
        {
          "stable_id": "93d2de3d-f851-4563-9ee3-e63c3551018a",
          "type": "string",
          "key": "description",
          "value": "Define the request preflight path from final prompt token accounting through capacity estimation, conservative admission, queue placement, largest-fit scheduling, and launch-time recheck. This step includes the request dynamic VRAM formula and the LMCache admission constraint only as admission semantics, not as cache storage management."
        },
