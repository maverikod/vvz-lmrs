        {
          "stable_id": "81dbb8e3-7490-4837-8e1e-0e88392dcc78",
          "type": "string",
          "key": "name",
          "value": "Model Disk Cache, Memory Lifecycle, and LMCache Storage"
        },
        {
          "stable_id": "cd5a2fc4-d609-4221-b168-1bd30c678beb",
          "type": "string",
          "key": "description",
          "value": "Define the model disk cache lifecycle, explicit model memory load and unload lifecycle, and vLLM LMCache integration as a cache subsystem. This step separates model files, model residency, LMCache runtime artifacts, CPU and disk cache tiers, and cache telemetry from GPU admission capacity."
        },
