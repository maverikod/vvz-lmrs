                      "type": "string",
                      "value": "model_access_core does not manage VRAM for local models"
                    },
                    {
                      "stable_id": "ac8b75c0-8fc3-4238-83e7-f4d7eaddc678",
                      "type": "string",
                      "value": "model_access_core does not load local models directly"
                    },
