                },
                {
                  "stable_id": "8d9d4165-71df-4491-9e49-298970570eb1",
                  "type": "string",
                  "key": "definition",
                  "value": "The disk-resident model cache that stores model weights, tokenizer files, runtime metadata, integrity information, readiness state, and cache profile independently from VRAM residency."
                },
                {
                  "stable_id": "fed2be31-0a78-4e02-8f5c-5387a97bf64d",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "a827c223-4416-4231-b884-6d5056643f24",
                      "type": "string",
                      "value": "Preload downloads, verifies integrity, prepares local layout, tokenizer files, runtime metadata, and readiness marker without requiring VRAM load."
                    },
                    {
                      "stable_id": "c11af98e-8e57-4a08-8e88-6784e27ae890",
                      "type": "string",
                      "value": "Disk cache and VRAM model residency are separate states."
                    },
                    {
                      "stable_id": "0ffcd65d-79bd-47e2-9101-fe3b1ef2d02c",
                      "type": "string",
                      "value": "Model states include not_cached, caching, cached_on_disk, loading_to_memory, loaded_in_memory, unloading, and failed."
                    },
                    {
                      "stable_id": "6d611271-d8b5-4e68-acc6-921ff0f874ab",
                      "type": "string",
                      "value": "Cache management commands add, check, delete, list, verify integrity, and update metadata."
                    },
                    {
                      "stable_id": "d6572246-b092-404d-9d2c-427779367585",
                      "type": "string",
                      "value": "Cache profile stores model_name, runtime, model_path, quantization/profile, declared_context_window, tokenizer profile, checksum or revision, disk size, load date, compatibility flags, and cache status."
                    }
                  ]
                },
                {
