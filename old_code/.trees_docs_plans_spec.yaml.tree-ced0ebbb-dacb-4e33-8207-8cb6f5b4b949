                },
                {
                  "stable_id": "710b33ba-3ef7-4380-9ba7-46e5ed6fb8d7",
                  "type": "string",
                  "key": "name",
                  "value": "MVP Scope"
                },
                {
                  "stable_id": "a4773a17-21b9-40cb-9e99-fecb0582acd3",
                  "type": "string",
                  "key": "definition",
                  "value": "The explicit boundary of features included and excluded from the initial LMRS implementation."
                },
                {
                  "stable_id": "481aa52e-ed24-4a09-b9be-87379bc0d48e",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "d32471a9-c570-46ed-a9d7-192633bf85bc",
                      "type": "string",
                      "value": "MVP includes one resident LLM on one GPU, persistent vectorizer/chunker services, service baseline measurement, model static measurement, tokenizer-aware counting, admission, largest-fit queue, one selected runtime backend, and adapter-based MCP commands."
                    },
                    {
                      "stable_id": "b4041166-f7e2-45b8-a500-65e0ed4c4d95",
                      "type": "string",
                      "value": "MVP excludes multi-GPU scheduling, multiple resident LLMs, streaming, speculative decoding, distributed inference, automatic model eviction, and advanced batching optimizer."
                    },
                    {
                      "stable_id": "f418e52c-dddb-4ae8-9eca-d83e7a683017",
                      "type": "string",
                      "value": "MVP includes disk cache lifecycle, explicit memory load/unload, VRAM measurement after load, and basic vLLM LMCache configuration support."
                    }
                  ]
                },
                {
                  "stable_id": "52dbf365-5400-41c8-82e9-2a5de1266cd6",
