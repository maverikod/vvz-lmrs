                  "value": "LMCache Integration"
                },
                {
                  "stable_id": "e10d84c6-5bec-4a8a-bd15-f28378993936",
                  "type": "string",
                  "key": "definition",
                  "value": "The vLLM LMCache runtime caching integration used to accelerate reuse of repeated or long context while preserving conservative admission decisions."
                },
                {
                  "stable_id": "32d354ca-ae40-4602-aeb2-32adf31f5fc2",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "1b55760f-ace6-46a2-a7ec-c906d20016a2",
                      "type": "string",
                      "value": "LMCache is a separate runtime/caching backend and does not replace admission control."
                    },
                    {
                      "stable_id": "16e076b4-54f9-45fa-8c20-e688b22829ec",
                      "type": "string",
                      "value": "Disk model cache and LMCache are distinct caches with different artifacts."
                    },
                    {
                      "stable_id": "85200f13-4d22-4e5f-a8de-d23811d8fe13",
                      "type": "string",
                      "value": "Estimate responses may include cache_reuse_possible, estimated_cache_hit_tokens, effective_new_tokens, and cache_estimate_quality when pre-execution cache information is available."
                    },
                    {
                      "stable_id": "faf675fa-739f-4090-b853-b9a8bcc41e50",
                      "type": "string",
                      "value": "If a cache hit is not guaranteed before launch, admission estimates the request as a full cache miss."
