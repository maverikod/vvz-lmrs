                  "children": [
                    {
                      "stable_id": "f7db4fd4-f37a-4311-a19d-424c096c7c78",
                      "type": "string",
                      "value": "Each command inherits the adapter Command base class."
                    },
                    {
                      "stable_id": "6596e1d3-66c8-450b-aada-5d14e3455420",
                      "type": "string",
                      "value": "Each command exposes a stable name and uses use_queue for long-running work when required."
                    },
                    {
                      "stable_id": "f4452f64-55a5-4967-88ae-12fd05153561",
                      "type": "string",
                      "value": "Each command validates parameters, delegates to a domain executor or service, and returns adapter SuccessResult or ErrorResult."
                    },
                    {
                      "stable_id": "48a5ceca-1f0d-4429-89c6-5a6c9cf06bf3",
