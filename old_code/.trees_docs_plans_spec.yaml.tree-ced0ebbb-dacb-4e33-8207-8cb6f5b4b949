                  "key": "definition",
                  "value": "The hook-based mechanism that registers LMRS public command classes with the adapter command registry before the adapter server starts."
                },
                {
                  "stable_id": "a5818d13-da1e-439c-8dce-385976bb1a68",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "0209b301-a1e2-4307-aa1e-db59af54f555",
                      "type": "string",
                      "value": "Registration is centralized in a dedicated register_lmrs_commands(registry) module function."
                    },
                    {
                      "stable_id": "710aa7e1-1b00-4388-9e92-ed5335a2cc67",
                      "type": "string",
                      "value": "Registration is idempotent and checks whether a command is already registered before registering it."
                    },
                    {
                      "stable_id": "36d36b41-682f-4eed-a513-2b45868df1d3",
                      "type": "string",
