                },
                {
                  "stable_id": "0df0571f-c9e8-4a1d-b57d-ed5863a9454b",
                  "type": "string",
                  "key": "name",
                  "value": "Local Model Runtime Service"
                },
                {
                  "stable_id": "7019d882-dd83-4397-9010-4f1febab08a1",
                  "type": "string",
                  "key": "definition",
                  "value": "A standalone adapter-based microservice that provides high-level access to locally executed language models while enforcing prompt admission before runtime execution."
                },
                {
                  "stable_id": "b74736de-f1f7-458a-aea1-0a09aa5dc524",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "1cd7b1c5-3b3f-4ddc-b4a7-6e74e772caa2",
                      "type": "string",
                      "value": "It is separate from model_access_core and ollama/model_workspace."
                    },
                    {
                      "stable_id": "91aadf0f-91bd-411f-81d6-49ce471fad0c",
                      "type": "string",
                      "value": "It exposes local model access through an adapter-based MCP interface."
                    },
                    {
                      "stable_id": "3b06cc16-e95d-4b91-88f3-80dd65082de4",
                      "type": "string",
                      "value": "It must prevent any prompt from reaching the local model runtime until context-window and dynamic VRAM capacity have been proven."
                    }
                  ]
                },
                {
                  "stable_id": "0836e09f-8b98-429d-b3ee-61519b78b133",
                  "type": "array",
                  "key": "source_labels",
