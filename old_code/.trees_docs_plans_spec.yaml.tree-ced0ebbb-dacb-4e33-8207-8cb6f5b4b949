                },
                {
                  "stable_id": "210b1e01-d121-4c48-9a4f-93398ca30d4a",
                  "type": "string",
                  "key": "definition",
                  "value": "The public MCP command surface implemented according to mcp_proxy_adapter conventions."
                },
                {
                  "stable_id": "48af1b27-f9c8-46d1-8ee7-3d76c66f8282",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "95334080-a55f-48d3-93b5-56ff68637cc7",
                      "type": "string",
                      "value": "The service is built on mcp_proxy_adapter principles."
                    },
                    {
                      "stable_id": "630a261e-ebbb-48c9-98cd-965f8e8add47",
                      "type": "string",
                      "value": "Public commands expose schemas, validation, execution, metadata, structured responses, structured errors, healthcheck, and MCP Proxy registration."
                    }
                  ]
                },
                {
                  "stable_id": "15fe7f1e-47d0-41fe-9efe-c749dcfcd530",
