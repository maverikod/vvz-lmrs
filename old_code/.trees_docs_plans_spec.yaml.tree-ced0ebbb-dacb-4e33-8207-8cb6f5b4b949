                  "type": "string",
                  "key": "definition",
                  "value": "The minimum stable command surface exposed by LMRS for health, capacity, admission, chat, queue, cache, and model lifecycle operations."
                },
                {
                  "stable_id": "12760a61-c0a5-4eda-b976-ccf4837650e5",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "9b5a63a1-e451-4099-a1e3-f44ada91d80b",
                      "type": "string",
                      "value": "The minimal runtime command set includes healthcheck, model status, capacity, token counting, dry-run estimate/admission, chat request, queue status, and request cancellation."
                    },
                    {
                      "stable_id": "4c923672-dda2-4c47-9110-3b518c9c9a0c",
                      "type": "string",
                      "value": "The estimate command performs dry-run admission and returns would_execute, would_queue, or would_reject with reason code, token breakdown, and capacity snapshot."
                    },
                    {
                      "stable_id": "aafd0e35-0ea3-448e-8806-4caaf0bfdcac",
                      "type": "string",
                      "value": "The chat command performs token counting and admission, then returns executed, queued, or rejected with the appropriate result, queue state, or stable reason code."
                    },
                    {
                      "stable_id": "4847538a-a4f0-4886-b8f3-d2639bf393fe",
                      "type": "string",
                      "value": "Additional cache and memory commands include local_model_cache_preload, local_model_cache_status, local_model_cache_delete, local_model_load, local_model_unload, and local_model_reload."
                    }
