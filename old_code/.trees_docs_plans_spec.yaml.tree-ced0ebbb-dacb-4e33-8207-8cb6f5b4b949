                },
                {
                  "stable_id": "ec772674-0944-4244-a6f1-597931cf3be9",
                  "type": "string",
                  "key": "definition",
                  "value": "The request structure accepted from the provider gateway for local model execution or admission decisions."
                },
                {
                  "stable_id": "dea18d24-4305-499d-9ebe-160d6e57b0dd",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "4a2cf472-11db-4860-beb3-a352d603a3bf",
                      "type": "string",
                      "value": "It contains session_id, request_id, model_name, messages, tools, reserved_output_tokens, and options."
                    },
                    {
                      "stable_id": "bbe4bd40-aab8-4305-b8f4-7f0f9eadc1ac",
                      "type": "string",
                      "value": "It is close to the canonical chat request used by the provider gateway."
                    }
                  ]
                },
                {
                  "stable_id": "59438e11-2c23-442c-abe7-2fb9b8f47e1e",
