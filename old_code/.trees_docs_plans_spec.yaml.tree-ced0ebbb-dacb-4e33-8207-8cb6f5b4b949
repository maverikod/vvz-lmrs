                },
                {
                  "stable_id": "6c77e985-f469-4195-b92a-f2a41ed2c96f",
                  "type": "string",
                  "key": "name",
                  "value": "Hardware Profile"
                },
                {
                  "stable_id": "2270ff79-e75d-4ea2-acb2-834def1a05c8",
                  "type": "string",
                  "key": "definition",
                  "value": "The hardware capacity description used for admission and calibration decisions."
                },
                {
                  "stable_id": "1582c689-726c-48d6-8c56-0a4f264d1882",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "610f9ca0-8652-4ece-9911-c9b6d2901d5f",
                      "type": "string",
                      "value": "The initial target profile is one GPU with 24 GB VRAM and 128 GB RAM."
                    },
                    {
                      "stable_id": "4097feef-a6ce-4ba9-93ba-b748dc888aac",
                      "type": "string",
                      "value": "The architecture must allow future larger VRAM cards and multiple GPUs without changing the external provider contract."
                    }
                  ]
                },
                {
                  "stable_id": "fb141752-15ae-4205-9b00-07f45ddd5e31",
                  "type": "array",
                  "key": "source_labels",
                  "children": [
                    {
                      "stable_id": "0c1a158f-d176-46c1-b6d7-b6f8d81dd68f",
                      "type": "string",
                      "value": "{hw01}"
                    }
                  ]
                }
              ]
            },
            {
              "stable_id": "94bee629-f937-4789-8e36-4d8d91927078",
              "type": "object",
              "children": [
                {
                  "stable_id": "590634b1-1050-4613-a1ad-35fd2fa0c5d7",
                  "type": "string",
                  "key": "concept_id",
                  "value": "C-007"
                },
                {
                  "stable_id": "049c18bc-b189-44a5-8bff-2cd2fcdec4e4",
                  "type": "string",
                  "key": "name",
                  "value": "Resident GPU Services Baseline"
                },
                {
                  "stable_id": "f9c0ec32-9de3-4469-b8cd-c54274950027",
                  "type": "string",
                  "key": "definition",
                  "value": "The measured GPU baseline after always-on GPU resident services are running and before the main LLM is loaded."
                },
                {
                  "stable_id": "af000980-5cd0-4a5f-ad20-de5e2afe4ee9",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "dfb03f03-cc81-4e3e-ad79-68495e6ae233",
                      "type": "string",
                      "value": "Resident services may include vectorizer, chunker, CUDA/runtime buffers, and other always-on processes."
                    },
                    {
                      "stable_id": "5f3faa41-3950-497a-a853-86678692fe85",
                      "type": "string",
                      "value": "The baseline is not an empty GPU state."
                    },
                    {
                      "stable_id": "d43d1bfc-854c-43c8-894c-d327f92008e4",
                      "type": "string",
                      "value": "The service measures service_baseline_free_vram at start or calibration."
                    }
                  ]
                },
                {
                  "stable_id": "33ebafa2-40d5-41b0-aaba-da9cb508423e",
                  "type": "array",
                  "key": "source_labels",
                  "children": [
                    {
