                    {
                      "stable_id": "d76dc90e-1a0e-452e-bbab-568d313afc9e",
                      "type": "string",
                      "value": "Telemetry includes predicted tokens, predicted VRAM, actual prompt tokens, actual output tokens, latency, queue wait, VRAM snapshots, admission verdict, and reason code."
                    },
                    {
                      "stable_id": "3a233560-636e-4d71-9658-705281a2a5ad",
                      "type": "string",
                      "value": "Telemetry supports calibration of KV-cache cost, per-request overhead, safety margin, and scheduler policy."
                    },
                    {
                      "stable_id": "b5440229-8be8-44ca-89f7-7f63fccdf152",
                      "type": "string",
                      "value": "LMCache telemetry includes hit/miss, reused tokens, new tokens, lookup latency, write latency, eviction events, and impact on actual VRAM and latency."
                    }
                  ]
                },
                {
                  "stable_id": "85e93cb0-786e-401c-a885-4b77b15cec97",
