                    {
                      "stable_id": "0c919280-ccbc-4c7d-ad92-1713cc386e47",
                      "type": "string",
                      "value": "Dynamic VRAM estimate is based on required_tokens, calibrated KV-cache cost per token, and per-request overhead."
                    },
