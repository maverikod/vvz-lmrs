                {
                  "stable_id": "4f114fbd-9714-4e97-8f55-bb2664f8b212",
                  "type": "string",
                  "key": "name",
                  "value": "Model Profile"
                },
                {
                  "stable_id": "a5c64337-8031-49dc-af4f-4575f5328be5",
                  "type": "string",
                  "key": "definition",
                  "value": "A model-specific runtime description that makes LMRS independent from any one local model."
                },
                {
                  "stable_id": "05f2d682-12f6-411b-896c-22a8be0fb7a5",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "5dd3b370-da1e-491c-8428-23c7dd4fd02c",
                      "type": "string",
                      "value": "It includes model_name, runtime backend, path or endpoint, declared context window, tokenizer profile, load policy, KV-cache profile, and concurrency policy."
                    },
                    {
                      "stable_id": "77e4a98b-d95c-4015-9c72-43e965f8229b",
                      "type": "string",
                      "value": "Qwen, Ollama models, GPT-OSS, and other local models are instances described by profiles."
                    }
                  ]
                },
                {
                  "stable_id": "3b8cc884-208c-46da-aa2e-6ed3855b7770",
                  "type": "array",
                  "key": "source_labels",
                  "children": [
