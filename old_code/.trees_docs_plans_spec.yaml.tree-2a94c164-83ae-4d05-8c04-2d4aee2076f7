                },
                {
                  "stable_id": "15c1e007-0059-42ac-86c2-922fbde3295d",
                  "type": "string",
                  "key": "definition",
                  "value": "The pre-queue decision process that classifies requests as executable, queueable, or rejected using context-window and VRAM capacity constraints."
                },
                {
                  "stable_id": "d149f7db-79ea-41dd-8d0a-4bfcc8265b88",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "090a872e-6b0c-44e5-8975-89ad4cc8b491",
                      "type": "string",
                      "value": "Admission runs before a request enters the queue."
                    },
                    {
                      "stable_id": "da9ff335-26c2-4ed6-9b76-33df018193f5",
                      "type": "string",
                      "value": "Requests over the model context window are rejected with CONTEXT_OVERFLOW."
                    },
                    {
                      "stable_id": "9abe8fbe-1e20-4fd5-bb2e-932bf4a44035",
                      "type": "string",
                      "value": "Requests too large for the maximum dynamic pool are rejected with REQUEST_TOO_LARGE or HARDWARE_VRAM_INSUFFICIENT."
                    },
                    {
                      "stable_id": "168ac9fe-48ca-4b1b-a5e8-4d93b30890c7",
                      "type": "string",
                      "value": "Requests that fit the maximum dynamic pool but not current capacity are queued, not permanently rejected."
                    },
                    {
                      "stable_id": "dcd9a8ef-c406-4448-ac83-b1855f4d5b3b",
                      "type": "string",
                      "value": "Requests fitting both model window and current dynamic pool may execute immediately or be queued according to scheduler policy."
                    },
                    {
                      "stable_id": "d2c32ecf-2db3-4b6f-b58c-808f6b99abe7",
