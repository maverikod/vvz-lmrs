                      "type": "string",
                      "value": "{mem1}"
                    }
                  ]
                }
              ]
            },
            {
              "stable_id": "3ba53720-29ef-4388-89f7-c1b8cb1eb695",
              "type": "object",
              "children": [
                {
                  "stable_id": "99de583d-95a6-48a2-8a87-e1fc86952bc2",
                  "type": "string",
                  "key": "concept_id",
                  "value": "C-008"
                },
                {
                  "stable_id": "d2b53091-1178-4973-b03d-c2c376bd6cf7",
                  "type": "string",
                  "key": "name",
                  "value": "VRAM Runtime Facts"
                },
                {
                  "stable_id": "729be230-248e-442f-8c5a-ef6c85e65b95",
                  "type": "string",
                  "key": "definition",
                  "value": "Measured runtime facts describing baseline free VRAM, model-loaded free VRAM, measured model static VRAM, and dynamic pool capacity."
                },
                {
                  "stable_id": "a4fea728-9b4e-46ba-aba3-fdcda41686e0",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "9bd6ca81-3bfa-4edc-a299-f910a9ad9f85",
                      "type": "string",
                      "value": "model_loaded_free_vram is measured after loading the local model."
                    },
                    {
                      "stable_id": "ac3d5784-e985-492d-a09f-342ada0c82cd",
                      "type": "string",
                      "value": "measured_model_static_vram is the difference between service_baseline_free_vram and model_loaded_free_vram."
                    },
                    {
                      "stable_id": "bba89160-fc3a-444b-8e6a-6a21cda130d5",
                      "type": "string",
                      "value": "Measured static VRAM is stored for model_name, runtime, quantization/profile, and hardware_profile."
                    },
                    {
                      "stable_id": "9275425e-6357-4910-82a8-7285d00a72f1",
                      "type": "string",
                      "value": "Runtime facts must not be replaced by purely theoretical assumptions."
                    }
                  ]
                },
                {
                  "stable_id": "c4c9aa8c-f93e-4802-93c8-91b8c2e42223",
                  "type": "array",
                  "key": "source_labels",
                  "children": [
                    {
                      "stable_id": "75a25bbb-dd76-4ca2-a512-7284598f24e8",
                      "type": "string",
                      "value": "{load}"
                    },
                    {
                      "stable_id": "3c14e96a-2a17-4c68-8a18-991424d81501",
                      "type": "string",
                      "value": "{stat}"
                    },
                    {
                      "stable_id": "ec1c313c-e71c-4ae5-83e1-2db4d8d0d51c",
                      "type": "string",
                      "value": "{inv3}"
                    }
                  ]
                }
              ]
            },
            {
              "stable_id": "5b126e53-2c7b-417b-bdad-b2a8de79de39",
              "type": "object",
              "children": [
                {
                  "stable_id": "42715381-96fe-4e8b-b460-095a7fa13542",
                  "type": "string",
                  "key": "concept_id",
                  "value": "C-009"
                },
                {
                  "stable_id": "dff1980f-0180-492d-8efc-d8a2d551c183",
                  "type": "string",
                  "key": "name",
                  "value": "Dynamic VRAM Pool"
                },
                {
                  "stable_id": "7335f14a-43ac-40a1-bf3f-2aef5d8925b0",
                  "type": "string",
                  "key": "definition",
                  "value": "The remaining VRAM capacity available for KV-cache, runtime buffers, batching overhead, and active request reservations after resident services and model static memory."
                },
                {
                  "stable_id": "030a688e-4c4a-4a57-a47b-4388e238336b",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "4a97a44a-d096-4fa1-894b-fb929fb50959",
                      "type": "string",
                      "value": "Maximum dynamic pool is computed from free VRAM after model load minus safety margin and runtime reserve."
                    },
                    {
                      "stable_id": "57f9909c-3a35-46c2-bc63-0a17efd4ae91",
                      "type": "string",
                      "value": "Current dynamic pool additionally subtracts active request reservations."
                    },
                    {
                      "stable_id": "43e8fc37-16c7-41be-aeac-8c375d557164",
                      "type": "string",
                      "value": "The dynamic pool bounds whether requests execute immediately, queue, or reject."
                    }
                  ]
                },
                {
                  "stable_id": "e3253775-7be9-4fbb-9f7f-66180ab5e8a0",
                  "type": "array",
                  "key": "source_labels",
                  "children": [
                    {
                      "stable_id": "b8ebf723-b979-4db5-95a7-2e3f63625942",
                      "type": "string",
                      "value": "{dyn1}"
                    },
                    {
                      "stable_id": "28ea42db-cf5a-4ae7-a01a-1a6968c259a1",
                      "type": "string",
                      "value": "{dyn2}"
                    },
                    {
                      "stable_id": "48f7f614-e6b7-4c60-9015-4ba127d5f1a2",
                      "type": "string",
                      "value": "{lim3}"
                    }
                  ]
                }
              ]
            },
            {
              "stable_id": "ca264ef6-52ed-4bf7-a469-d563892c2878",
              "type": "object",
              "children": [
                {
                  "stable_id": "df0ed046-0909-4456-98a2-a101a2b4a607",
                  "type": "string",
                  "key": "concept_id",
                  "value": "C-010"
                },
                {
                  "stable_id": "c9ca215a-2309-4c9e-8f58-bf8d79309cfa",
                  "type": "string",
                  "key": "name",
                  "value": "Token Accounting"
                },
                {
                  "stable_id": "1f719757-a803-48a1-8bf1-02495230f572",
                  "type": "string",
                  "key": "definition",
                  "value": "The tokenizer-aware accounting process that computes request token requirements before queuing and before runtime execution."
                },
                {
                  "stable_id": "0b475417-c53c-41d8-a0bb-c19ba401f813",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "87f9be64-e478-4cfb-9a9c-0a884d2838ee",
                      "type": "string",
                      "value": "Token counting covers final prompt/chat-template content, system messages, role markers, assistant/user messages, tool schemas, service headers, and reserved output tokens."
                    },
                    {
                      "stable_id": "cbfdd886-8715-4f9a-be9f-7494f05767c4",
                      "type": "string",
                      "value": "The preferred mode uses the tokenizer matching the executing model and runtime."
                    },
                    {
                      "stable_id": "264d825f-87d9-436e-8a08-3f043cadaa34",
                      "type": "string",
                      "value": "Rough chars/4 estimates are allowed only as explicitly marked fallback."
                    },
                    {
                      "stable_id": "32bdbd30-be45-4b10-b4f2-dcf52a89fe3e",
                      "type": "string",
                      "value": "If exact tokenizer is unavailable, the service either uses explicitly allowed approximate mode or rejects with TOKENIZER_UNAVAILABLE."
                    }
                  ]
                },
