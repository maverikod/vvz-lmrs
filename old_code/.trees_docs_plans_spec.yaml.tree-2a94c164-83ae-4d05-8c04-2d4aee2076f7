                },
                {
                  "stable_id": "75a8d50f-4e7a-4d7a-abb9-ebc2d9d02b69",
                  "type": "string",
                  "key": "definition",
                  "value": "The lifecycle that explicitly loads, unloads, reloads, and reports model residency in memory independently from disk cache availability."
                },
                {
                  "stable_id": "bbb9e99d-ae29-4cd6-b0f5-33e8bb871295",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "00883906-b49d-48aa-a06c-906f19acdcfd",
                      "type": "string",
                      "value": "Loading to memory is separate from disk cache preload."
                    },
                    {
                      "stable_id": "24de1143-e2b6-415f-8966-281b95701b60",
                      "type": "string",
                      "value": "Lifecycle commands include load_model, unload_model, reload_model, model_status, and model_lifecycle_status."
                    },
                    {
                      "stable_id": "306af286-357f-4fd5-bbfa-0aa1ca6a1a75",
                      "type": "string",
                      "value": "Before loading, the service verifies disk cache presence and runtime compatibility or returns MODEL_NOT_CACHED unless preload is explicitly allowed."
                    },
                    {
                      "stable_id": "a7f61ea0-75ea-46c8-a7d9-7801a54a37d8",
                      "type": "string",
                      "value": "After loading, the service measures model_loaded_free_vram and records measured_model_static_vram."
                    },
                    {
                      "stable_id": "be06e2c8-837b-4393-a2f4-a0a0bac9a515",
                      "type": "string",
                      "value": "Unloading frees VRAM residency without requiring disk cache deletion and updates free VRAM state."
                    },
