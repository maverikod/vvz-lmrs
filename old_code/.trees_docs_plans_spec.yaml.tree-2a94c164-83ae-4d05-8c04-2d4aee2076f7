                  "children": [
                    {
                      "stable_id": "95334080-a55f-48d3-93b5-56ff68637cc7",
                      "type": "string",
                      "value": "The service is built on mcp_proxy_adapter principles."
                    },
                    {
                      "stable_id": "630a261e-ebbb-48c9-98cd-965f8e8add47",
                      "type": "string",
                      "value": "Public commands expose schemas, validation, execution, metadata, structured responses, structured errors, healthcheck, and MCP Proxy registration."
                    }
                  ]
                },
