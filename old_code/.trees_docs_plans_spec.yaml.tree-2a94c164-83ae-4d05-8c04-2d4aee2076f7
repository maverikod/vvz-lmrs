                  "key": "name",
                  "value": "Provider Gateway Integration"
                },
                {
                  "stable_id": "86e84232-689f-4c7f-8f96-21fced2e4708",
                  "type": "string",
                  "key": "definition",
                  "value": "The integration boundary through which model_access_core routes local provider requests to the Local Model Runtime Service."
                },
                {
                  "stable_id": "06521b73-dba6-4641-88c1-f736b5f60b5e",
                  "type": "array",
                  "key": "properties",
                  "children": [
                    {
                      "stable_id": "97996ab4-edcf-4e5a-a6c8-802cc1f27524",
                      "type": "string",
                      "value": "model_access_core remains the universal provider gateway."
                    },
                    {
                      "stable_id": "d6d9b2e7-1800-42aa-9613-069665ad2f9c",
                      "type": "string",
                      "value": "model_access_core does not manage VRAM, load local models, or execute local prompts directly."
                    },
                    {
                      "stable_id": "e4c3be09-20b6-4d11-a9a1-4e8f44e112c4",
                      "type": "string",
                      "value": "LMRS appears to model_access_core as a local provider backend and returns responses normalizable into canonical provider responses."
                    }
                  ]
                },
                {
                  "stable_id": "15e5bfec-2588-4b9b-928d-7a818d1bd069",
                  "type": "array",
