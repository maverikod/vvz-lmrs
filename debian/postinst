#!/bin/sh
set -e

LMRS_USER=lmrsuser
LMRS_GROUP=lmrsgrp
LMRS_UID=42424
LMRS_GID=42424
ETC_DIR=/etc/lmrs
CERT_DIR=/etc/lmrs/certs
DATA_DIR=/var/lmrs
LOG_DIR=/var/log/lmrs
DEFAULT_FILE=/etc/default/lmrs
IMAGE_FILE=/var/lmrs/docker-image

case "$1" in
  configure)
    if getent group "$LMRS_GID" >/dev/null && [ "$(getent group "$LMRS_GID" | cut -d: -f1)" != "$LMRS_GROUP" ]; then
      echo "lmrs: gid $LMRS_GID is already used by another group" >&2
      exit 1
    fi
    if getent passwd "$LMRS_UID" >/dev/null && [ "$(getent passwd "$LMRS_UID" | cut -d: -f1)" != "$LMRS_USER" ]; then
      echo "lmrs: uid $LMRS_UID is already used by another user" >&2
      exit 1
    fi
    if ! getent group "$LMRS_GROUP" >/dev/null; then
      addgroup --system --gid "$LMRS_GID" "$LMRS_GROUP"
    elif [ "$(getent group "$LMRS_GROUP" | cut -d: -f3)" != "$LMRS_GID" ]; then
      groupmod -g "$LMRS_GID" "$LMRS_GROUP"
    fi
    if ! id "$LMRS_USER" >/dev/null 2>&1; then
      adduser --system --uid "$LMRS_UID" --ingroup "$LMRS_GROUP" --no-create-home --home "$DATA_DIR" "$LMRS_USER"
    else
      if [ "$(id -u "$LMRS_USER")" != "$LMRS_UID" ]; then usermod -u "$LMRS_UID" "$LMRS_USER"; fi
      if [ "$(id -g "$LMRS_USER")" != "$LMRS_GID" ]; then usermod -g "$LMRS_GID" "$LMRS_USER"; fi
    fi
    if getent group docker >/dev/null; then
      adduser "$LMRS_USER" docker >/dev/null || true
    fi

    install -d -o root -g "$LMRS_GROUP" -m 0750 "$ETC_DIR" "$CERT_DIR"
    chgrp -R "$LMRS_GROUP" "$ETC_DIR"
    install -d -o "$LMRS_USER" -g "$LMRS_GROUP" -m 0750 "$DATA_DIR" "$DATA_DIR/cache" "$DATA_DIR/hf-cache" "$LOG_DIR"
    chown -R "$LMRS_USER:$LMRS_GROUP" "$DATA_DIR" "$LOG_DIR"

    if [ ! -f "$ETC_DIR/config.json" ]; then
      install -o root -g "$LMRS_GROUP" -m 0640 /usr/share/lmrs/config.json.template "$ETC_DIR/config.json"
    fi
    if [ -d "$ETC_DIR/lmcache.yaml" ]; then
      rm -rf "$ETC_DIR/lmcache.yaml"
    fi
    if [ ! -f "$ETC_DIR/lmcache.yaml" ]; then
      install -o root -g "$LMRS_GROUP" -m 0640 /usr/share/lmrs/lmcache.yaml.template "$ETC_DIR/lmcache.yaml"
    fi
    if [ ! -f "$DEFAULT_FILE" ]; then
      install -o root -g "$LMRS_GROUP" -m 0640 /usr/share/lmrs/lmrs.default.template "$DEFAULT_FILE"
    else
      chgrp "$LMRS_GROUP" "$DEFAULT_FILE"
      chmod 0640 "$DEFAULT_FILE"
    fi

    install -o "$LMRS_USER" -g "$LMRS_GROUP" -m 0644 /usr/share/lmrs/docker-image "$IMAGE_FILE"
    IMAGE_REF=$(cat "$IMAGE_FILE")
    if grep -q ^LMRS_IMAGE= "$DEFAULT_FILE"; then
      sed -i "s|^LMRS_IMAGE=.*|LMRS_IMAGE=$IMAGE_REF|" "$DEFAULT_FILE"
    else
      echo "LMRS_IMAGE=$IMAGE_REF" >> "$DEFAULT_FILE"
    fi

    systemctl daemon-reload || true
    if [ -s "$ETC_DIR/config.json" ]; then
      systemctl enable lmrs.service >/dev/null || true
      systemctl restart lmrs.service || true
    else
      echo "LMRS config is empty; edit $ETC_DIR/config.json and run: systemctl start lmrs" >&2
    fi
    ;;
esac

#DEBHELPER#
exit 0
