#!/usr/bin/env bash
# prerm for lmrs: stop/disable the service and remove the container.
#
# Author: Vasiliy Zdanovskiy
# email: vasilyvz@gmail.com
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop lmrs.service >/dev/null 2>&1 || true
            systemctl disable lmrs.service >/dev/null 2>&1 || true
        fi
        if command -v docker >/dev/null 2>&1 && [ -x /usr/lib/lmrs/bin/lmrs-container ]; then
            /usr/lib/lmrs/bin/lmrs-container remove || true
        fi
        ;;
esac

#DEBHELPER#
exit 0
