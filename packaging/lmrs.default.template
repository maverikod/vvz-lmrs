# LMRS container image published on Docker Hub.
LMRS_IMAGE=vasilyvz/lmrs:latest
LMRS_CONTAINER_NAME=lmrs

# Host identity. The Debian package creates this user/group and the container runs
# with the same numeric ids.
LMRS_USER=lmrsuser
LMRS_GROUP=lmrsgrp
LMRS_UID=42424
LMRS_GID=42424

# Public listener for LMRS. vLLM stays internal to the same container.
LMRS_BIND=127.0.0.1
LMRS_PORT=8012

# Mounted host surface: settings, certificates, data, logs.
LMRS_CONFIG=/etc/lmrs/config.json
LMRS_CERT_DIR=/etc/lmrs/certs
LMRS_DATA_DIR=/var/lmrs
LMRS_LOG_DIR=/var/log/lmrs
LMRS_ENV_FILE=/etc/default/lmrs

# GPU access for vLLM inside the container. Use a comma-separated GPU list or all.
LMRS_GPUS=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# vLLM/LMCache runtime inside the LMRS container.
LMRS_MODEL=
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_EXTRA_ARGS="--gpu-memory-utilization 0.80"
LMCACHE_CONFIG_FILE=/etc/lmrs/lmcache.yaml

# HuggingFace Hub access for model weights.
#
# vLLM calls snapshot_download on every start, even when the cache volume already
# holds the model. Unauthenticated that call can stall indefinitely, and it
# stalls silently: no log line after "Using FlashAttention version 2", no
# download progress, no .incomplete file. Set HF_TOKEN so the request is not
# rate-limited; that is the one setting known to matter here.
#
# HF_HUB_OFFLINE=1 makes a start that cannot reach the Hub fail fast instead of
# hanging, which is easier to diagnose, but it also blocks fetching a model that
# is not cached yet. It is left off by default: on a host observed 2026-07-30 it
# turned the hang into LocalEntryNotFoundError even though refs/main matched the
# cached snapshot, and that resolution failure is not yet understood. Turn it on
# deliberately, per host, once the cache is known to satisfy the request.
HF_TOKEN=
HF_HUB_OFFLINE=

# Admission inputs. Every one of these is a policy figure, not a measurement:
# LMRS measures free VRAM itself and subtracts these reserves from it. Left
# empty they are zero, which means the whole free pool is offered to requests.
#
# LMRS_RESIDENT_SERVICES is a comma-separated list of the always-on GPU services
# running beside the model; it is recorded with the baseline measurement so a
# later reader knows what the baseline included.
LMRS_RESIDENT_SERVICES=
LMRS_SAFETY_MARGIN_BYTES=
LMRS_RUNTIME_RESERVE_BYTES=
LMRS_PER_REQUEST_OVERHEAD_BYTES=
LMRS_RUNTIME_BATCH_OVERHEAD_BYTES=

# KV-cache element dtype, when vLLM is told to keep the KV cache in something
# other than the model dtype (--kv-cache-dtype). Empty means the model dtype
# decides. Weight quantization alone never shrinks the KV cache.
LMRS_KV_CACHE_DTYPE=

# How long an admitted-but-queued request stays valid, and the hardware profile
# identifier reported with measured VRAM facts.
LMRS_QUEUE_TTL_SECONDS=
LMRS_HARDWARE_PROFILE_ID=

# Where measured VRAM facts are persisted. The service baseline can only be
# measured before a model is loaded, so it is stored on the data volume and read
# back on later starts.
LMRS_VRAM_FACTS_PATH=/var/lmrs/vram-facts.json

# Disk model cache root. Empty means the image's HuggingFace hub cache, which is
# the directory vLLM itself downloads into.
LMRS_MODEL_CACHE_ROOT=
LMRS_LMCACHE_PATH=/var/lmrs/lmcache
