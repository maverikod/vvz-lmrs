# /etc/default/lmrs — LMRS container configuration.
# Read by the lmrs systemd unit and the lmrs-container helper, and passed into
# the container via `docker run --env-file`. After editing: systemctl restart lmrs

# --- Docker image (overrides /usr/share/lmrs/docker-image when set) ---
#LMRS_IMAGE=vasilyvz/lmrs:0.1.0

# --- External exposure (only the LMRS server is published) ---
LMRS_PORT=8012
# Bind address on the host: 127.0.0.1 = host-only, 0.0.0.0 = expose on network.
LMRS_BIND=127.0.0.1

# --- GPU (passed to `docker run --gpus`; empty disables GPU) ---
LMRS_GPUS=all

# --- vLLM model server (internal/loopback only, not published) ---
# HuggingFace model id or local path. Empty = run LMRS only, no in-container vLLM.
LMRS_MODEL=
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
# Extra args appended to `vllm serve` (LMCache connector, tensor-parallel, dtype, ...).
VLLM_EXTRA_ARGS=

# --- Paths (host side; bind-mounted into the container) ---
LMRS_CONFIG=/etc/lmrs/config.json
LMRS_RUN_DIR=/var/lmrs
LMRS_LOG_DIR=/var/log/lmrs
LMRS_HF_CACHE=/var/lmrs/hf-cache
