[Unit]
Description=Local Model Runtime Service (LMRS) container
Documentation=https://github.com/maverikod/vvz-lmrs
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
EnvironmentFile=-/etc/default/lmrs
ExecStart=/usr/lib/lmrs/bin/lmrs-container start
ExecStop=/usr/lib/lmrs/bin/lmrs-container stop

[Install]
WantedBy=multi-user.target
