#!/usr/bin/env bash
#
# Manage the LMRS Docker container (pull / recreate / start / stop / remove).
# Configuration comes from the environment (systemd EnvironmentFile
# /etc/default/lmrs). Only the LMRS port is published; vLLM stays internal.
#
# Author: Vasiliy Zdanovskiy
# email: vasilyvz@gmail.com
set -euo pipefail

CONTAINER_NAME="${LMRS_CONTAINER_NAME:-lmrs}"
ETC_DIR="${LMRS_ETC:-/etc/lmrs}"
VAR_DIR="${LMRS_RUN_DIR:-/var/lmrs}"
LOG_DIR="${LMRS_LOG_DIR:-/var/log/lmrs}"
PORT="${LMRS_PORT:-8012}"
BIND="${LMRS_BIND:-127.0.0.1}"
GPUS="${LMRS_GPUS:-all}"
HF_CACHE="${LMRS_HF_CACHE:-/var/lmrs/hf-cache}"
ENV_FILE="${LMRS_ENV_FILE:-/etc/default/lmrs}"

image_ref() {
    if [ -n "${LMRS_IMAGE:-}" ]; then
        printf '%s\n' "${LMRS_IMAGE}"
    elif [ -f /var/lmrs/docker-image ]; then
        cat /var/lmrs/docker-image
    elif [ -f /usr/share/lmrs/docker-image ]; then
        cat /usr/share/lmrs/docker-image
    else
        printf 'vasilyvz/lmrs:latest\n'
    fi
}

cmd_pull() {
    docker pull "$(image_ref)"
}

cmd_recreate() {
    local img
    img="$(image_ref)"
    docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    mkdir -p "${HF_CACHE}"
    local gpu_args=()
    [ -n "${GPUS}" ] && gpu_args=(--gpus "${GPUS}")
    local env_args=()
    [ -f "${ENV_FILE}" ] && env_args=(--env-file "${ENV_FILE}")
    docker run -d \
        --name "${CONTAINER_NAME}" \
        --restart unless-stopped \
        "${gpu_args[@]}" \
        "${env_args[@]}" \
        -p "${BIND}:${PORT}:8012" \
        -v "${ETC_DIR}:/etc/lmrs:ro" \
        -v "${VAR_DIR}:/var/lmrs" \
        -v "${LOG_DIR}:/var/log/lmrs" \
        -v "${HF_CACHE}:/root/.cache/huggingface" \
        "${img}"
}

cmd_start() {
    if docker inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
        docker start "${CONTAINER_NAME}"
    else
        cmd_recreate
    fi
}

cmd_stop() {
    docker stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
}

cmd_remove() {
    docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
}

case "${1:-}" in
    pull) cmd_pull ;;
    recreate) cmd_recreate ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    remove) cmd_remove ;;
    *) echo "usage: $0 {pull|recreate|start|stop|remove}" >&2; exit 2 ;;
esac
