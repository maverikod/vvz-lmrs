#!/bin/sh
set -eu

NAME=${LMRS_CONTAINER_NAME:-lmrs}
IMAGE=${LMRS_IMAGE:-vasilyvz/lmrs:latest}
LMRS_USER=${LMRS_USER:-lmrsuser}
LMRS_GROUP=${LMRS_GROUP:-lmrsgrp}
LMRS_UID=${LMRS_UID:-42424}
LMRS_GID=${LMRS_GID:-42424}
CONFIG=${LMRS_CONFIG:-/etc/lmrs/config.json}
CERT_DIR=${LMRS_CERT_DIR:-/etc/lmrs/certs}
DATA_DIR=${LMRS_DATA_DIR:-/var/lmrs}
LOG_DIR=${LMRS_LOG_DIR:-/var/log/lmrs}
LMCACHE_CONFIG=${LMCACHE_CONFIG_FILE:-/etc/lmrs/lmcache.yaml}
PORT=${LMRS_PORT:-8012}
BIND=${LMRS_BIND:-127.0.0.1}
GPUS=${LMRS_GPUS:-all}
ENV_FILE=${LMRS_ENV_FILE:-/etc/default/lmrs}

ensure_layout() {
  mkdir -p "$(dirname "$CONFIG")" "$CERT_DIR" "$DATA_DIR" "$DATA_DIR/cache" "$DATA_DIR/hf-cache" "$DATA_DIR/lmcache" "$LOG_DIR"
  chown -R "${LMRS_UID}:${LMRS_GID}" "$DATA_DIR" "$LOG_DIR" 2>/dev/null || true
}

container_exists() {
  docker ps -a --format '{{.Names}}' | grep -Fxq "$NAME"
}

pull_image() {
  docker pull "$IMAGE"
}

start_container() {
  ensure_layout
  if container_exists; then
    docker rm -f "$NAME" >/dev/null
  fi

  # The hf-cache and lmcache binds below look redundant next to the parent
  # bind of DATA_DIR, and with the current image they are. They stay because
  # images 0.1.4 and 0.1.5 declare VOLUME for those paths: without an explicit
  # bind, docker shadows each with a fresh anonymous volume, the container
  # loses sight of the downloaded weights, and vLLM silently re-downloads the
  # whole model on every start instead of serving. That shadowing is the root
  # cause of the "vLLM never comes up" incident of 2026-07-30.
  docker run -d \
    --name "$NAME" \
    --restart unless-stopped \
    --user "${LMRS_UID}:${LMRS_GID}" \
    --gpus "$GPUS" \
    -e NVIDIA_VISIBLE_DEVICES="$GPUS" \
    -e NVIDIA_DRIVER_CAPABILITIES="${NVIDIA_DRIVER_CAPABILITIES:-compute,utility}" \
    -e LMRS_MODEL="${LMRS_MODEL:-}" \
    -e VLLM_HOST="${VLLM_HOST:-127.0.0.1}" \
    -e VLLM_PORT="${VLLM_PORT:-8000}" \
    -e VLLM_EXTRA_ARGS="${VLLM_EXTRA_ARGS:-}" \
    -e LMCACHE_CONFIG_FILE="${LMCACHE_CONFIG_FILE:-/etc/lmrs/lmcache.yaml}" \
    -e HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-}" \
    -e HF_TOKEN="${HF_TOKEN:-}" \
    -e LMRS_LOG_DIR="${LMRS_LOG_DIR:-/var/log/lmrs}" \
    -e LMRS_RESIDENT_SERVICES="${LMRS_RESIDENT_SERVICES:-}" \
    -e LMRS_SAFETY_MARGIN_BYTES="${LMRS_SAFETY_MARGIN_BYTES:-}" \
    -e LMRS_RUNTIME_RESERVE_BYTES="${LMRS_RUNTIME_RESERVE_BYTES:-}" \
    -e LMRS_PER_REQUEST_OVERHEAD_BYTES="${LMRS_PER_REQUEST_OVERHEAD_BYTES:-}" \
    -e LMRS_RUNTIME_BATCH_OVERHEAD_BYTES="${LMRS_RUNTIME_BATCH_OVERHEAD_BYTES:-}" \
    -e LMRS_KV_CACHE_DTYPE="${LMRS_KV_CACHE_DTYPE:-}" \
    -e LMRS_QUEUE_TTL_SECONDS="${LMRS_QUEUE_TTL_SECONDS:-}" \
    -e LMRS_HARDWARE_PROFILE_ID="${LMRS_HARDWARE_PROFILE_ID:-}" \
    -e LMRS_VRAM_FACTS_PATH="${LMRS_VRAM_FACTS_PATH:-/var/lmrs/vram-facts.json}" \
    -e LMRS_MODEL_CACHE_ROOT="${LMRS_MODEL_CACHE_ROOT:-}" \
    -e LMRS_LMCACHE_PATH="${LMRS_LMCACHE_PATH:-/var/lmrs/lmcache}" \
    -p "${BIND}:${PORT}:8012" \
    -v "${CONFIG}:/etc/lmrs/config.json:ro" \
    -v "${CERT_DIR}:/etc/lmrs/certs:ro" \
    -v "${LMCACHE_CONFIG}:/etc/lmrs/lmcache.yaml:ro" \
    -v "${DATA_DIR}:/var/lmrs" \
    -v "${DATA_DIR}/hf-cache:/var/lmrs/hf-cache" \
    -v "${DATA_DIR}/lmcache:/var/lmrs/lmcache" \
    -v "${LOG_DIR}:/var/log/lmrs" \
    "$IMAGE"
}

stop_container() {
  if container_exists; then
    docker rm -f "$NAME" >/dev/null
  fi
}

status_container() {
  docker ps -a --filter "name=^/${NAME}$"
}

case "${1:-start}" in
  pull)
    pull_image
    ;;
  start|restart)
    pull_image
    start_container
    ;;
  stop)
    stop_container
    ;;
  status)
    status_container
    ;;
  *)
    echo "Usage: $0 {pull|start|restart|stop|status}" >&2
    exit 2
    ;;
esac
